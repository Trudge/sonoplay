HTTP_PORT=32488
HOST_IP=<your host IP>
CLIENT_PROFILE=Sonos|DLNA|Chromecast|Generic|Web|Android|iOS|Roku
ENABLE_ONBOARDING_WIZARD=1




# Optional Plex-backed authentication (prototype; disabled by default)
AUTH_ENABLED=false
# Comma-separated Plex user IDs or usernames. Empty accepts any Plex account.
AUTH_ALLOWED_USERS=
# Recommended: long random value. If unset, sessions reset on restart.
# AUTH_SESSION_SECRET=
# Set true when SonoPlay is served over HTTPS.
AUTH_COOKIE_SECURE=false
