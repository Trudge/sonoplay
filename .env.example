HTTP_PORT=32488
HOST_IP=<your host IP>
TRUSTED_HOSTS=
# Optional PMS override; otherwise resolved through plex.tv
# PMS_ADDRESS=192.168.1.10
# PMS_PORT=32400
CLIENT_PROFILE=Sonos|DLNA|Chromecast|Generic|Web|Android|iOS|Roku
ENABLE_ONBOARDING_WIZARD=1




# Optional Plex-backed authentication (prototype; disabled by default)
AUTH_ENABLED=false
# Comma-separated Plex user IDs or usernames. Required when auth is enabled.
AUTH_ALLOWED_USERS=
# Explicitly allow any Plex account (not recommended).
AUTH_ALLOW_ANY_USER=false
# Recommended: long random value. If unset, sessions reset on restart.
# AUTH_SESSION_SECRET=
# Set true when SonoPlay is served over HTTPS.
AUTH_COOKIE_SECURE=false
