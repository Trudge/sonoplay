# ── Deny everything by default ──
*

# ── Whitelist only what the build needs ──

# Build-stage: dependency install
!pyproject.toml
!requirements.txt
!requirements.lock

# Build-stage: package install
!src/

# Runtime: application code
!main.py
!logging_config.py
!redaction.py
!version.py
!plex/
!dlna/
!settings/
!utils/
!templates/
!static/

# Exclude Python bytecache from whitelisted dirs
**/__pycache__/
